def print_even_numbers():
    print("--- Even Numbers Between 1 and 100 ---")
    
    # Using a for loop with a step of 2 to efficiently target even numbers
    # Starting at 2 and ending at 101 to include 100
    for number in range(2, 101, 2):
        # Printing numbers on the same line for clean, readable formatting
        print(number, end=" ")
    
    print("\n---------------------------------------")

# Run the program
if __name__ == "__main__":
    print_even_numbers()

