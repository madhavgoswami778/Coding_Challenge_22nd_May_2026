#!/usr/bin/env python3

"""Grade calculator for a student based on marks in five subjects."""

SUBJECT_COUNT = 5

GRADE_THRESHOLDS = [
    (90, "A+"),
    (80, "A"),
    (70, "B+"),
    (60, "B"),
    (50, "C"),
    (40, "D"),
]


def calculate_grade(percentage):
    for threshold, grade in GRADE_THRESHOLDS:
        if percentage >= threshold:
            return grade
    return "F"


def parse_marks(input_str):
    parts = input_str.strip().split()
    if len(parts) != SUBJECT_COUNT:
        raise ValueError(f"Expected {SUBJECT_COUNT} marks, got {len(parts)}.")

    marks = []
    for part in parts:
        mark = float(part)
        if mark < 0 or mark > 100:
            raise ValueError("Marks must be between 0 and 100.")
        marks.append(mark)

    return marks


def main():
    try:
        raw_input = input(f"Enter marks for {SUBJECT_COUNT} subjects separated by spaces: ")
        marks = parse_marks(raw_input)
    except ValueError as err:
        print(f"Invalid input: {err}")
        return

    total = sum(marks)
    percentage = total / SUBJECT_COUNT
    grade = calculate_grade(percentage)

    print(f"Total marks: {total:.2f}")
    print(f"Percentage: {percentage:.2f}%")
    print(f"Grade: {grade}")


if __name__ == "__main__":
    main()
