def count_characters(string):
    """Count the occurrence of each character in a given string using a dictionary."""
    char_count = {}
    
    for char in string:
        if char in char_count:
            char_count[char] += 1
        else:
            char_count[char] = 1
    
    return char_count


# Test the function
if __name__ == "__main__":
    test_string = "hello world"
    result = count_characters(test_string)
    print(f"String: '{test_string}'")
    print(f"Character count: {result}")
    
    # Display in a formatted way
